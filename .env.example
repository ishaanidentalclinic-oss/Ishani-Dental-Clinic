# ── Database (Required) ────────────────────────────────────────────────────────
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.lvujho0.mongodb.net/ishaani-dental?appName=Cluster0

# ── JWT Authentication (Required for Admin Login) ──────────────────────────────
JWT_ACCESS_SECRET=ishaani-dental-access-secret-super-long-random-key-2024
JWT_REFRESH_SECRET=ishaani-dental-refresh-secret-different-super-long-key-2024
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN_LONG=30d

# ── Public URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=

# ── Vercel Blob Storage (Optional, for CMS Media Uploads) ──────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Email Notifications (Optional, SMTP / Gmail) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CLINIC_EMAIL=

# ── Google Calendar Sync (Optional) ───────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID_DR_RAGHAVENDRA=
GOOGLE_CALENDAR_ID_DR_MANJUSHRI=
